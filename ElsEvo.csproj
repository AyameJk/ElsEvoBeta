<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformVersion>10.0.19041.0</TargetPlatformVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ElsEvo</RootNamespace>
    <AssemblyName>ElsEvo</AssemblyName>
    <ApplicationIcon>Assets\icone_app.ico</ApplicationIcon>
    <DefineConstants>$(DefineConstants);ELSEVO_BETA</DefineConstants>

    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>

    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>

    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\*.png" />
    <Resource Include="Assets\*.gif" />
    <None Include="Assets\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.50.4" />
    <PackageReference Include="WpfAnimatedGif" Version="2.0.2" />
  </ItemGroup>

</Project>