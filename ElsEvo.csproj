<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ElsEvo</RootNamespace>
    <AssemblyName>ElsEvo</AssemblyName>
    <ApplicationIcon>Assets\icone_app.ico</ApplicationIcon>

    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>

    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>

    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>

    <Resource Include="Assets\*.png" />

    <None Include="Assets\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
