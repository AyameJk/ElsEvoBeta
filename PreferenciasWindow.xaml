<Window x:Class="ElsEvo.PreferenciasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações"
        Height="560"
        Width="420"
        MinHeight="420"
        MinWidth="420"
        Background="{DynamicResource CorFundoPrincipal}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Window.Resources>

        <Style x:Key="BotaoFlat" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CorBotaoFlat}"/>
            <Setter Property="Foreground" Value="{DynamicResource CorTextoPrimario}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fundo" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fundo" Property="Background" Value="{DynamicResource CorBotaoFlatHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="fundo" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotaoPrimario" TargetType="Button" BasedOn="{StaticResource BotaoFlat}">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1387E8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconeMdl2" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="#63B3ED"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,2,10,0"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{DynamicResource CorTextoPrimario}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{DynamicResource CorFundoCartao}"
                                BorderBrush="{DynamicResource CorBorda}"
                                BorderThickness="1" CornerRadius="8" Padding="10">
                            <StackPanel>
                                <TextBlock Text="{TemplateBinding Header}"
                                           Foreground="{DynamicResource CorTextoSecundario}"
                                           FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <ContentPresenter/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource CorTextoPrimario}"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource CorTextoPrimario}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="TextoSecundario">
            <Setter Property="Foreground" Value="{DynamicResource CorTextoSecundario}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource CorFundoCampo}"/>
            <Setter Property="Foreground" Value="{DynamicResource CorTextoPrimario}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CorBorda}"/>
        </Style>

        <Style x:Key="PolegarScrollbarModerno" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{DynamicResource CorBorda}"
                                CornerRadius="3"
                                Opacity="0.7"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,4">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource PolegarScrollbarModerno}" Width="6"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="14">

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Background="Transparent" BorderThickness="0">

            <TabItem x:Name="AbaElsword" Header="Elsword">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                <StackPanel>

                    <GroupBox x:Name="GrpLocalizacaoJogo" Header="LOCALIZAÇÃO DO JOGO">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Margin="0,0,8,0" ClipToBounds="True">
                                <Image Source="Assets/icone_elsword.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>

                            <TextBox x:Name="TxtLocalizacaoJogo"
                                     Grid.Column="1"
                                     Height="28"
                                     VerticalContentAlignment="Center"
                                     Padding="6,0"
                                     IsReadOnly="True"
                                     Text="ex: C:\Elsword\elsword.exe"/>

                            <Button Grid.Column="2"
                                    Width="32" Height="32"
                                    Padding="0"
                                    Margin="6,0,0,0"
                                    Style="{StaticResource BotaoFlat}"
                                    Click="BtnProcurarJogo_Click"
                                    ToolTip="Selecionar elsword.exe"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="13"
                                    Content="&#xE721;"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox x:Name="GrpOpcoesInicializacao" Header="OPÇÕES DE INICIALIZAÇÃO">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="&#xE756;" Style="{StaticResource IconeMdl2}"/>

                            <StackPanel Grid.Column="1">
                                <CheckBox x:Name="ChkNaoExecutarLauncher" Content="Não executar o launcher"/>
                                <TextBlock x:Name="TxtRecomendadoCoreano" Text="(recomendado para o servidor coreano)"
                                           Style="{StaticResource TextoSecundario}"
                                           Margin="20,0,0,10"/>

                                <CheckBox x:Name="ChkPularElsword"
                                          Content="Pular elsword.exe (avançado)"
                                          Checked="ChkPularElsword_CheckedChanged"
                                          Unchecked="ChkPularElsword_CheckedChanged"/>

                                <TextBox x:Name="TxtArgumentos"
                                         Height="26"
                                         Margin="20,4,0,0"
                                         Padding="6,0"
                                         VerticalContentAlignment="Center"
                                         IsEnabled="False"
                                         Text="argumentos | ex: 8f9slxa02nkp29ak1u26mqpcms"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox x:Name="GrpSeguranca" Header="SEGURANÇA">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="&#xE72E;" Style="{StaticResource IconeMdl2}"/>

                            <StackPanel Grid.Column="1">
                                <CheckBox x:Name="ChkBloquearLogs" Content="Bloquear arquivos de log"/>
                                <TextBlock x:Name="TxtAvisoLogs" Text="Aviso: somente logs client-side são bloqueados"
                                           Style="{StaticResource TextoSecundario}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="AbaInicializador" Header="Inicializador">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                <StackPanel>

                    <GroupBox x:Name="GrpIdiomas" Header="IDIOMAS">
                        <ComboBox x:Name="CmbIdioma" Height="28" SelectedIndex="0" SelectionChanged="CmbIdioma_SelectionChanged">
                            <ComboBoxItem x:Name="ItemIdiomaPortugues" Content="Português"/>
                            <ComboBoxItem x:Name="ItemIdiomaIngles" Content="Inglês"/>
                            <ComboBoxItem x:Name="ItemIdiomaChines" Content="Chinês"/>
                        </ComboBox>
                    </GroupBox>

                    <GroupBox x:Name="GrpTema" Header="TEMA">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#F5C542" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <RadioButton x:Name="RadioTemaClaro" GroupName="Tema" Content="Claro" Margin="0,0,20,0" Checked="RadioTema_Checked"/>

                            <TextBlock Text="&#xE708;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#A7B8D6" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <RadioButton x:Name="RadioTemaEscuro" GroupName="Tema" Content="Escuro" IsChecked="True" Checked="RadioTema_Checked"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox x:Name="GrpIconeBandeja" Header="ÍCONE DA ÁREA DE NOTIFICAÇÃO">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="&#xE7E7;" Style="{StaticResource IconeMdl2}"/>

                            <StackPanel Grid.Column="1">
                                <CheckBox x:Name="ChkMinimizarBandeja" Content="Minimizar para a área de notificação" IsChecked="True"/>
                                <CheckBox x:Name="ChkIniciarMinimizado" Content="Iniciar minimizado" Margin="0,4,0,0"/>
                                <CheckBox x:Name="ChkIniciarComWindows" Content="Iniciar com o Windows" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox x:Name="GrpAtualizacoes" Header="ATUALIZAÇÕES">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="&#xE72C;" Style="{StaticResource IconeMdl2}"/>

                            <StackPanel Grid.Column="1">
                                <CheckBox x:Name="ChkBuscarAtualizacoes" Content="Buscar por atualizações ao iniciar" IsChecked="True"/>
                                <CheckBox x:Name="ChkBetaApenas" Content="Beta apenas" Margin="0,4,0,0"/>
                                <TextBlock x:Name="TxtAvisoBetaApenas" Text="Desmarcado: o programa busca apenas versões estáveis"
                                           Style="{StaticResource TextoSecundario}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="AbaRede" Header="Rede">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                <StackPanel>

                    <GroupBox x:Name="GrpVelocidadeDownload" Header="VELOCIDADE DE DOWNLOAD">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="&#xEC4A;" Style="{StaticResource IconeMdl2}"/>

                            <StackPanel Grid.Column="1">
                                <CheckBox x:Name="ChkLimitarVelocidade"
                                          Content="Limitar velocidade de download"
                                          Checked="ChkLimitarVelocidade_CheckedChanged"
                                          Unchecked="ChkLimitarVelocidade_CheckedChanged"/>

                                <Grid Margin="20,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtLimiteVelocidade"
                                             Grid.Column="0"
                                             Height="26"
                                             Padding="6,0"
                                             VerticalContentAlignment="Center"
                                             IsEnabled="False"/>
                                    <TextBlock Grid.Column="1" Text="KB/s" Foreground="{DynamicResource CorTextoSecundario}"
                                               FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </Grid>
                                <TextBlock Text="Ex.: 1000 KB/s ≈ 1 MB/s."
                                           Style="{StaticResource TextoSecundario}"
                                           Margin="20,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox x:Name="GrpConexao" Header="CONEXÃO">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="&#xE968;" Style="{StaticResource IconeMdl2}"/>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Tempo limite ao verificar atualizações" FontSize="12" Foreground="{DynamicResource CorTextoPrimario}"/>
                                <ComboBox x:Name="CmbTimeoutAtualizacao" Height="26" Margin="0,4,0,10" SelectedIndex="1">
                                    <ComboBoxItem Content="5 segundos" Tag="5"/>
                                    <ComboBoxItem Content="10 segundos" Tag="10"/>
                                    <ComboBoxItem Content="15 segundos" Tag="15"/>
                                    <ComboBoxItem Content="30 segundos" Tag="30"/>
                                </ComboBox>

                                <TextBlock Text="Tempo limite ao baixar dublagens" FontSize="12" Foreground="{DynamicResource CorTextoPrimario}"/>
                                <ComboBox x:Name="CmbTimeoutDownload" Height="26" Margin="0,4,0,10" SelectedIndex="2">
                                    <ComboBoxItem Content="10 minutos" Tag="10"/>
                                    <ComboBoxItem Content="30 minutos" Tag="30"/>
                                    <ComboBoxItem Content="60 minutos" Tag="60"/>
                                    <ComboBoxItem Content="120 minutos" Tag="120"/>
                                </ComboBox>

                                <TextBlock Text="Tentativas automáticas em caso de falha" FontSize="12" Foreground="{DynamicResource CorTextoPrimario}"/>
                                <ComboBox x:Name="CmbTentativas" Height="26" Margin="0,4,0,10" SelectedIndex="2">
                                    <ComboBoxItem Content="1 (sem repetir)" Tag="1"/>
                                    <ComboBoxItem Content="2 tentativas" Tag="2"/>
                                    <ComboBoxItem Content="3 tentativas" Tag="3"/>
                                    <ComboBoxItem Content="5 tentativas" Tag="5"/>
                                </ComboBox>

                                <TextBlock Text="Downloads simultâneos na fila" FontSize="12" Foreground="{DynamicResource CorTextoPrimario}"/>
                                <ComboBox x:Name="CmbDownloadsSimultaneos" Height="26" Margin="0,4,0,0" SelectedIndex="0">
                                    <ComboBoxItem Content="1 (um de cada vez)" Tag="1"/>
                                    <ComboBoxItem Content="2 ao mesmo tempo" Tag="2"/>
                                    <ComboBoxItem Content="3 ao mesmo tempo" Tag="3"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox x:Name="GrpRedeLimitada" Header="REDE LIMITADA">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="&#xE7BA;" Style="{StaticResource IconeMdl2}"/>

                            <StackPanel Grid.Column="1">
                                <CheckBox x:Name="ChkAvisarRedeLimitada" Content="Avisar antes de baixar em rede limitada (medida)" IsChecked="True"/>
                                <TextBlock Text="Ex.: hotspot do celular ou plano de dados com limite."
                                           Style="{StaticResource TextoSecundario}"
                                           Margin="20,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox x:Name="GrpProxy" Header="PROXY">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="&#xE774;" Style="{StaticResource IconeMdl2}"/>

                            <StackPanel Grid.Column="1">
                            <CheckBox x:Name="ChkProxyHabilitado"
                                      Content="Usar proxy manual"
                                      Checked="ChkProxyHabilitado_CheckedChanged"
                                      Unchecked="ChkProxyHabilitado_CheckedChanged"/>

                            <Grid Margin="20,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Endereço" FontSize="11" Foreground="{DynamicResource CorTextoSecundario}" Margin="0,0,0,2"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Porta" FontSize="11" Foreground="{DynamicResource CorTextoSecundario}" Margin="0,0,0,2"/>

                                <TextBox x:Name="TxtProxyEndereco"
                                         Grid.Row="1" Grid.Column="0"
                                         Height="26" Padding="6,0"
                                         VerticalContentAlignment="Center"
                                         IsEnabled="False"
                                         Margin="0,0,6,8"/>

                                <TextBox x:Name="TxtProxyPorta"
                                         Grid.Row="1" Grid.Column="1"
                                         Height="26" Padding="6,0"
                                         VerticalContentAlignment="Center"
                                         IsEnabled="False"
                                         Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Usuário (opcional)" FontSize="11" Foreground="{DynamicResource CorTextoSecundario}" Margin="0,0,0,2"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Senha" FontSize="11" Foreground="{DynamicResource CorTextoSecundario}" Margin="0,0,0,2"/>

                                <TextBox x:Name="TxtProxyUsuario"
                                         Grid.Row="3" Grid.Column="0"
                                         Height="26" Padding="6,0"
                                         VerticalContentAlignment="Center"
                                         IsEnabled="False"
                                         Margin="0,0,6,0"/>

                                <PasswordBox x:Name="TxtProxySenha"
                                             Grid.Row="3" Grid.Column="1"
                                             Height="26" Padding="6,0"
                                             VerticalContentAlignment="Center"
                                             IsEnabled="False"
                                             Background="{DynamicResource CorFundoCampo}"
                                             Foreground="{DynamicResource CorTextoPrimario}"
                                             BorderBrush="{DynamicResource CorBorda}"/>
                            </Grid>
                            <TextBlock Text="Usuário e senha são opcionais -- só necessários se o proxy exigir autenticação."
                                       Style="{StaticResource TextoSecundario}"
                                       Margin="20,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnOk" Content="OK" Width="80" Style="{StaticResource BotaoFlat}" Margin="0,0,8,0" Click="BtnOk_Click"/>
            <Button x:Name="BtnCancelar" Content="Cancelar" Width="80" Style="{StaticResource BotaoFlat}" Margin="0,0,8,0" Click="BtnCancelar_Click"/>
            <Button x:Name="BtnAplicar" Content="Aplicar" Width="80" IsEnabled="False" Style="{StaticResource BotaoPrimario}" Click="BtnAplicar_Click"/>
        </StackPanel>

    </Grid>

</Window>
