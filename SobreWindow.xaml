<Window x:Class="ElsEvo.SobreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sobre o ElsEvo"
        Height="360"
        Width="480"
        Background="{DynamicResource CorFundoPrincipal}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="BotaoPrimario" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1387E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    CornerRadius="8"
                    ClipToBounds="True"
                    Margin="0,0,14,0">
                <Image Source="Assets/imagem_sobre.png"
                       Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <StackPanel Grid.Column="1">

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="ElsEvo"
                               Foreground="{DynamicResource CorTextoPrimario}"
                               FontSize="18"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtVersao"
                               Text="1.0"
                               Foreground="#63B3ED"
                               FontSize="13"
                               FontWeight="Bold"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"/>
                    <Border x:Name="BadgeBeta"
                            Background="#D32F2F"
                            CornerRadius="8"
                            Padding="6,1"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                        <TextBlock Text="BETA" Foreground="White" FontSize="9" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <TextBlock x:Name="TxtDescricao"
                           Foreground="{DynamicResource CorTextoSecundario}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           TextAlignment="Justify"
                           LineHeight="17"
                           Margin="0,0,0,12"/>

                <TextBlock x:Name="TxtRotuloAutor" Foreground="{DynamicResource CorTextoSecundario}" FontSize="11" FontWeight="SemiBold" Text="Autor:"/>
                <TextBlock Foreground="{DynamicResource CorTextoPrimario}" FontSize="12" Text="AyameJk" Margin="0,2,0,0"/>

                <TextBlock x:Name="TxtVersaoBeta"
                           Foreground="{DynamicResource CorTextoSecundario}"
                           FontSize="10"
                           Margin="0,6,0,0"
                           Visibility="Collapsed"/>

            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="OK" Width="90" Style="{StaticResource BotaoPrimario}" Click="BtnOk_Click"/>
        </StackPanel>

    </Grid>

</Window>
