<Window x:Class="ElsEvo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ElsEvo"
        Height="470"
        Width="400"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        WindowStyle="None"
        StateChanged="Window_StateChanged"
        ResizeMode="CanResize">

    <Window.Resources>

        <Style x:Key="BotaoJanela" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3A3A3D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotaoJogar" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1387E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BotaoToggle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource CorTextoPrimario}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="fundoTopo"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                       ContentSource="Icon"
                                                       Margin="0,0,6,0"
                                                       VerticalAlignment="Center"/>
                                    <ContentPresenter Grid.Column="1"
                                                       ContentSource="Header"
                                                       VerticalAlignment="Center"
                                                       RecognizesAccessKey="True"/>
                                </Grid>
                            </Border>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False">
                                <Border Background="{DynamicResource CorFundoCartao}"
                                        BorderBrush="{DynamicResource CorBorda}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="4"
                                        MinWidth="180">
                                    <StackPanel IsItemsHost="True"/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="fundoTopo" Property="Background" Value="{DynamicResource CorBotaoFlatHover}"/>
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuItem">
                                <Setter Property="Padding" Value="10,6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border Background="{DynamicResource CorFundoCartao}" CornerRadius="12" BorderBrush="{DynamicResource CorBorda}" BorderThickness="1">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  x:Name="BarraTitulo"
                  Height="36"
                  Background="Transparent"
                  MouseLeftButtonDown="BarraTitulo_MouseLeftButtonDown">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">

                    <Border Width="22" Height="22" CornerRadius="11" Margin="0,0,8,0" ClipToBounds="True" Background="{DynamicResource CorFundoPrincipal}">
                        <Image Source="Assets/icone_app.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <TextBlock Text="ElsEvo" Foreground="{DynamicResource CorTextoPrimario}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>

                    <Border x:Name="BadgeBeta"
                            Background="#D32F2F"
                            CornerRadius="8"
                            Padding="6,1"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                        <TextBlock Text="BETA" Foreground="White" FontSize="9" FontWeight="Bold"/>
                    </Border>

                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,4,4,0">
                    <Button Style="{StaticResource BotaoJanela}" Click="BtnMinimizar_Click" ToolTip="Minimizar" Content="&#xE921;"/>
                    <Button x:Name="BtnMaximizar" Style="{StaticResource BotaoJanela}" Click="BtnMaximizar_Click" ToolTip="Maximizar" Content="&#xE922;"/>
                    <Button Style="{StaticResource BotaoJanela}" Click="BtnFechar_Click" ToolTip="Fechar" Content="&#xE8BB;"/>
                </StackPanel>

            </Grid>

            <Grid Grid.Row="1" Margin="16,0,16,16">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Button x:Name="BtnToggleLigado"
                            HorizontalAlignment="Right"
                            Click="BtnToggleLigado_Click"
                            Style="{StaticResource BotaoToggle}"
                            ToolTip="Clique para ativar/desativar os mods">
                        <Border x:Name="BadgeBorder"
                                Background="#2E7D32"
                                CornerRadius="12"
                                Padding="12,4">
                            <TextBlock x:Name="StatusBadge"
                                       Text="LIGADO"
                                       Foreground="White"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Button>
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">

                    <Menu Background="Transparent" BorderThickness="0" Margin="0,0,4,0">

                        <MenuItem x:Name="MenuItemAcoes" Header="Ações">
                            <MenuItem x:Name="ItemReiniciar" Header="Reiniciar Programa" Click="MenuReiniciar_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Foreground="#63B3ED" FontSize="14"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="ItemLimparCache" Header="Limpar Cache" Click="MenuLimparCache_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Foreground="#63B3ED" FontSize="14"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="ItemLimparConfiguracoes" Header="Limpar Configurações" Click="MenuLimparConfiguracoes_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" Foreground="#63B3ED" FontSize="14"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem x:Name="ItemExcluirMods" Header="Excluir Todos os Mods" Click="MenuExcluirMods_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" Foreground="#E36464" FontSize="14"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>

                        <MenuItem x:Name="MenuItemConfiguracoes" Header="Configurações" Click="MenuConfiguracoes_Click"/>

                        <MenuItem x:Name="MenuItemSobre" Header="Sobre" Click="MenuSobre_Click"/>

                    </Menu>

                </StackPanel>

                <Grid Grid.Row="2" Margin="0,0,0,16">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="TxtModsAtivos" Text="Mods Ativos" Foreground="{DynamicResource CorTextoSecundario}" FontSize="11" FontWeight="SemiBold" Margin="2,0,0,6"/>

                    <Border Grid.Row="1" Background="{DynamicResource CorFundoPrincipal}" CornerRadius="8" BorderBrush="{DynamicResource CorBorda}" BorderThickness="1" Padding="8">

                        <Grid>

                            <TextBlock x:Name="TxtListaVazia"
                                       Text="Nenhum mod ativo. Use &quot;Gerenciar Mods&quot; para importar."
                                       Foreground="{DynamicResource CorTextoSecundario}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"/>

                            <ListBox x:Name="ListaModsAtivos"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource CorTextoPrimario}"
                                     FontSize="13"/>

                        </Grid>

                    </Border>

                </Grid>

                <StackPanel Grid.Row="3">

                    <Button x:Name="BtnGerenciarMods"
                            Content="Gerenciar Mods"
                            Height="36"
                            Margin="0,0,0,10"
                            Background="{DynamicResource CorBotaoFlat}"
                            Foreground="{DynamicResource CorTextoPrimario}"
                            FontWeight="SemiBold"
                            Style="{StaticResource BotaoJogar}"
                            Click="BtnGerenciarMods_Click"/>

                    <Button x:Name="BtnJogar"
                            Content="Aplicar e Jogar"
                            Height="44"
                            Background="#0078D4"
                            Foreground="White"
                            FontSize="14"
                            FontWeight="Bold"
                            Style="{StaticResource BotaoJogar}"
                            Click="BtnJogar_Click"/>

                    <Grid Margin="0,8,0,0" x:Name="ProgressoContainer" Visibility="Collapsed">
                        <Border Height="18" CornerRadius="9" Background="{DynamicResource CorFundoPrincipal}" BorderBrush="{DynamicResource CorBorda}" BorderThickness="1">
                            <Grid>
                                <ProgressBar x:Name="BarraProgresso" Minimum="0" Maximum="100" Value="0" Height="16" Margin="1">
                                    <ProgressBar.Template>
                                        <ControlTemplate TargetType="ProgressBar">
                                            <Grid>
                                                <Border CornerRadius="8" Background="Transparent"/>
                                                <Border x:Name="PART_Track" CornerRadius="8"/>
                                                <Border x:Name="PART_Indicator"
                                                        CornerRadius="8"
                                                        Background="#0078D4"
                                                        HorizontalAlignment="Left"
                                                        Width="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Value}"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </ProgressBar.Template>
                                </ProgressBar>
                                <TextBlock x:Name="TxtProgresso" Text="0%" Foreground="White" FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">

                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="0" Opacity="0.85"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>

                </StackPanel>

            </Grid>

        </Grid>

    </Border>

</Window>
