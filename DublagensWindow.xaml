<Window x:Class="ElsEvo.DublagensWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Baixar dublagens"
        Height="390"
        Width="520"
        MinHeight="340"
        MinWidth="420"
        Background="{DynamicResource CorFundoPrincipal}"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="BotaoFlat" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CorBotaoFlat}"/>
            <Setter Property="Foreground" Value="{DynamicResource CorTextoPrimario}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fundo" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fundo" Property="Background" Value="{DynamicResource CorBotaoFlatHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="fundo" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BotaoPrimario" TargetType="Button" BasedOn="{StaticResource BotaoFlat}">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Dublagens disponíveis"
                       Foreground="{DynamicResource CorTextoPrimario}"
                       FontSize="16"
                       FontWeight="Bold"/>
            <TextBlock Text="Escolha um pacote para baixar e instalar nos seus mods."
                       Foreground="{DynamicResource CorTextoSecundario}"
                       FontSize="11"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="{DynamicResource CorFundoCartao}"
                BorderBrush="{DynamicResource CorBorda}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="6">
            <ListBox x:Name="ListaDublagens"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="{DynamicResource CorTextoPrimario}"
                     SelectionChanged="ListaDublagens_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="9,8" Margin="0,1" CornerRadius="5" Background="Transparent">
                            <StackPanel>
                                <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{Binding Descricao}" Foreground="{DynamicResource CorTextoSecundario}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="TxtStatus"
                       Text="Carregando dublagens..."
                       Foreground="{DynamicResource CorTextoSecundario}"
                       FontSize="11"/>
            <ProgressBar x:Name="BarraProgresso"
                         Height="14"
                         Margin="0,6,0,0"
                         Minimum="0"
                         Maximum="100"
                         Value="0"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnCancelar" Content="Cancelar" Style="{StaticResource BotaoFlat}" Margin="0,0,8,0" Click="BtnCancelar_Click"/>
            <Button x:Name="BtnBaixar" Content="Baixar dublagem" Style="{StaticResource BotaoPrimario}" IsEnabled="False" Click="BtnBaixar_Click"/>
        </StackPanel>
    </Grid>
</Window>
