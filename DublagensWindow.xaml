<Window x:Class="ElsEvo.DublagensWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        Title="Baixar dublagens"
        Height="440"
        Width="520"
        MinHeight="380"
        MinWidth="420"
        Background="{DynamicResource CorFundoPrincipal}"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="BotaoFlat" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CorBotaoFlat}"/>
            <Setter Property="Foreground" Value="{DynamicResource CorTextoPrimario}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fundo" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fundo" Property="Background" Value="{DynamicResource CorBotaoFlatHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="fundo" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BotaoPrimario" TargetType="Button" BasedOn="{StaticResource BotaoFlat}">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="BarraProgressoEstilizada" TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Height="14" CornerRadius="7" Background="{DynamicResource CorFundoPrincipal}"
                                BorderBrush="{DynamicResource CorBorda}" BorderThickness="1">
                            <Grid>
                                <Border CornerRadius="6" Background="Transparent" Margin="1"/>
                                <Border x:Name="PART_Track" CornerRadius="6" Margin="1"/>
                                <Border x:Name="PART_Indicator"
                                        CornerRadius="6"
                                        Background="#0078D4"
                                        Margin="1"
                                        HorizontalAlignment="Left"
                                        Width="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Value}"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconeCheckBaixado" TargetType="TextBlock">
            <Setter Property="Text" Value="&#xE73E;"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#69E292"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RotuloProgresso" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource CorTextoSecundario}"/>
        </Style>

        <Style x:Key="CheckBoxSelecaoDublagem" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="22" Height="22">
                            <Image x:Name="IconeDesmarcado" Source="Assets/download-desmarcado.png" Stretch="Uniform"/>
                            <Image x:Name="IconeMarcado" Source="Assets/download-marcado.png" Stretch="Uniform" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="IconeDesmarcado" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="IconeMarcado" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="fundo" Background="Transparent" CornerRadius="5">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fundo" Property="Background" Value="{DynamicResource CorBotaoFlatHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="fundo" Property="Background" Value="#0078D4"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="TxtTituloDublagens" Text="Dublagens disponíveis"
                       Foreground="{DynamicResource CorTextoPrimario}"
                       FontSize="16"
                       FontWeight="Bold"/>
            <TextBlock x:Name="TxtInstrucaoDublagens" Text="Escolha um ou mais pacotes para baixar e instalar nos seus mods."
                       Foreground="{DynamicResource CorTextoSecundario}"
                       FontSize="11"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="{DynamicResource CorFundoCartao}"
                BorderBrush="{DynamicResource CorBorda}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="6">
            <ListBox x:Name="ListaDublagens"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="{DynamicResource CorTextoPrimario}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="9,8" Margin="0,1" CornerRadius="5" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0"
                                          Style="{StaticResource CheckBoxSelecaoDublagem}"
                                          IsChecked="{Binding Selecionado, Mode=TwoWay}"
                                          Margin="0,0,10,0"/>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="{Binding Descricao}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource CorTextoSecundario}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding TamanhoFormatado}"
                                               FontSize="10"
                                               Margin="0,2,0,0"
                                               Visibility="{Binding VisibilidadeTamanho}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource CorTextoSecundario}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                        <Setter Property="Foreground" Value="#D8E8FF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="10,0,0,0"
                                            Visibility="{Binding VisibilidadeBaixando}">
                                    <Image Width="32" Height="32" VerticalAlignment="Center"
                                           gif:ImageBehavior.AnimatedSource="Assets/download-loading.gif"/>
                                    <TextBlock Text="{Binding TextoBaixando}" Foreground="#E0B060" FontSize="10" FontWeight="SemiBold" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="20,0,0,0"
                                            Visibility="{Binding VisibilidadeAguardando}">
                                    <Image Width="22" Height="22" VerticalAlignment="Center"
                                           Source="Assets/relogio-fila.png"/>
                                    <TextBlock Text="{Binding TextoNaFila}" Foreground="#E0B060" FontSize="10" FontWeight="SemiBold" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="10,0,0,0"
                                            Visibility="{Binding VisibilidadeInstalado}">
                                    <TextBlock Style="{StaticResource IconeCheckBaixado}"/>
                                    <TextBlock Text="{Binding TextoInstalado}" Foreground="#69E292" FontSize="10" FontWeight="SemiBold" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="10,0,0,0"
                                            Visibility="{Binding VisibilidadePausado}">
                                    <TextBlock Text="&#xE769;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#63B3ED" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding TextoPausado}" Foreground="#63B3ED" FontSize="10" FontWeight="SemiBold" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="TxtStatus"
                       Text="Carregando dublagens..."
                       Foreground="{DynamicResource CorTextoSecundario}"
                       FontSize="11"/>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtFilaTotal" Grid.Column="0" Text="Fila (total)" Style="{StaticResource RotuloProgresso}"/>
                <TextBlock x:Name="TxtPercentFila" Grid.Column="1" Text="0%" Style="{StaticResource RotuloProgresso}"/>
            </Grid>
            <ProgressBar x:Name="BarraProgressoFila"
                         Style="{StaticResource BarraProgressoEstilizada}"
                         Height="14"
                         Margin="0,2,0,0"
                         Minimum="0"
                         Maximum="100"
                         Value="0"/>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtArquivoAtual" Grid.Column="0" Text="Arquivo atual" Style="{StaticResource RotuloProgresso}"/>
                <TextBlock x:Name="TxtPercentAtual" Grid.Column="1" Text="0%" Style="{StaticResource RotuloProgresso}"/>
            </Grid>
            <ProgressBar x:Name="BarraProgresso"
                         Style="{StaticResource BarraProgressoEstilizada}"
                         Height="14"
                         Margin="0,2,0,0"
                         Minimum="0"
                         Maximum="100"
                         Value="0"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnPausar" Content="Pausar" Style="{StaticResource BotaoFlat}" Margin="0,0,8,0" IsEnabled="False" Visibility="Collapsed" Click="BtnPausar_Click"/>
            <Button x:Name="BtnCancelar" Content="Cancelar" Style="{StaticResource BotaoFlat}" Margin="0,0,8,0" IsEnabled="False" Click="BtnCancelar_Click"/>
            <Button x:Name="BtnBaixar" Content="Baixar dublagem" Style="{StaticResource BotaoPrimario}" IsEnabled="False" Click="BtnBaixar_Click"/>
        </StackPanel>
    </Grid>
</Window>
