<Application x:Class="ElsEvo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>

        <!-- ===== Cores padrão de FALLBACK (tema Escuro) — garante que DynamicResource
             sempre tenha um valor, mesmo antes do ThemeManager rodar. Sem isso, se por
             qualquer motivo AplicarTemaSalvo() não rodar a tempo, os elementos ficam sem
             cor nenhuma (o que na prática aparece como fundo branco/transparente). ===== -->
        <SolidColorBrush x:Key="CorFundoPrincipal" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="CorFundoCartao" Color="#252526"/>
        <SolidColorBrush x:Key="CorFundoCampo" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="CorBorda" Color="#3F3F46"/>
        <SolidColorBrush x:Key="CorTextoPrimario" Color="#E3E3E3"/>
        <SolidColorBrush x:Key="CorTextoSecundario" Color="#858585"/>
        <SolidColorBrush x:Key="CorBotaoFlat" Color="#2D2D30"/>
        <SolidColorBrush x:Key="CorBotaoFlatHover" Color="#3A3A3D"/>

        <!-- ===== ComboBox escuro (aplica em TODAS as janelas automaticamente) ===== -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource CorFundoCampo}"/>
            <Setter Property="Foreground" Value="{DynamicResource CorTextoPrimario}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CorBorda}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="toggle"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="1"
                                                           Text="&#xE70D;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="9"
                                                           Foreground="{DynamicResource CorTextoSecundario}"
                                                           Margin="0,0,10,0"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="conteudo"
                                               IsHitTestVisible="False"
                                               Content="{TemplateBinding SelectionBoxItem}"
                                               ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                               Margin="{TemplateBinding Padding}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Left"/>

                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="{DynamicResource CorFundoCartao}"
                                        BorderBrush="{DynamicResource CorBorda}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="240"
                                        Margin="0,2,0,0">
                                    <ScrollViewer Margin="2">
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource CorTextoPrimario}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="fundo" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="fundo" Property="Background" Value="{DynamicResource CorBotaoFlatHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== TabControl / TabItem escuros ===== -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource CorTextoSecundario}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="fundo"
                                Background="Transparent"
                                BorderBrush="{DynamicResource CorBorda}"
                                BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="fundo" Property="BorderBrush" Value="#0078D4"/>
                                <Setter Property="Foreground" Value="{DynamicResource CorTextoPrimario}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

    </Application.Resources>
</Application>
