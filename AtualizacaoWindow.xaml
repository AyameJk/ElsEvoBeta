<Window x:Class="ElsEvo.AtualizacaoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Atualização disponível"
        Width="420"
        SizeToContent="Height"
        MinHeight="220"
        Background="{DynamicResource CorFundoPrincipal}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>

        <Style x:Key="BotaoFlat" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CorBotaoFlat}"/>
            <Setter Property="Foreground" Value="{DynamicResource CorTextoPrimario}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fundo" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fundo" Property="Background" Value="{DynamicResource CorBotaoFlatHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotaoPrimario" TargetType="Button" BasedOn="{StaticResource BotaoFlat}">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1387E8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===== Scrollbar fina e arredondada (substitui a scrollbar cinza padrão do
             Windows, que destoa do resto da interface flat/moderna) ===== -->
        <Style x:Key="PolegarScrollbarModerno" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{DynamicResource CorBorda}"
                                CornerRadius="3"
                                Opacity="0.7"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,4">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource PolegarScrollbarModerno}" Width="6"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="18">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho: ícone + título + versão -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="38" Height="38"
                    CornerRadius="19"
                    Background="#0078D4"
                    Margin="0,0,12,0">
                <TextBlock Text="&#xE896;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="18"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TxtTitulo"
                           Text="Atualização disponível"
                           Foreground="{DynamicResource CorTextoPrimario}"
                           FontSize="15"
                           FontWeight="Bold"/>
                <TextBlock x:Name="TxtVersaoNova"
                           Foreground="#63B3ED"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Notas da release — montadas dinamicamente no code-behind, na MESMA ORDEM
             em que texto/imagem/citação aparecem no Markdown original (ver PrepararNotas
             em AtualizacaoWindow.xaml.cs). -->
        <Border Grid.Row="1"
                x:Name="ContainerNotas"
                Background="{DynamicResource CorFundoCartao}"
                BorderBrush="{DynamicResource CorBorda}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10"
                Margin="0,0,0,10"
                MaxHeight="320">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PainelNotas"/>
            </ScrollViewer>
        </Border>

        <!-- Aviso de canal beta (só aparece quando a atualização vem do canal beta) -->
        <Border Grid.Row="2"
                x:Name="ContainerAvisoBeta"
                Background="#3D2E1A"
                BorderBrush="#8A6D3B"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10"
                Margin="0,0,0,10"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7BA;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="14"
                           Foreground="#F5C542"
                           VerticalAlignment="Top"
                           Margin="0,1,8,0"/>
                <TextBlock x:Name="TxtAvisoBeta"
                           Text="Essa é uma versão BETA (canal de testes) — pode ter bugs que a versão estável não tem. Ela será instalada por cima da sua instalação atual."
                           Foreground="#E3D2A8"
                           FontSize="11"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3"
                   x:Name="TxtAvisoFechamento"
                   Text="O ElsEvo vai fechar durante a instalação e reabrir sozinho automaticamente ao terminar."
                   Foreground="{DynamicResource CorTextoSecundario}"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16"/>

        <!-- Botões -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnAgoraNao"
                    Content="Agora não"
                    Width="110"
                    Style="{StaticResource BotaoFlat}"
                    Margin="0,0,8,0"
                    Click="BtnAgoraNao_Click"/>
            <Button x:Name="BtnAtualizar"
                    Content="Atualizar agora"
                    Width="140"
                    Style="{StaticResource BotaoPrimario}"
                    Click="BtnAtualizar_Click"/>
        </StackPanel>

    </Grid>

</Window>
