<Window x:Class="ElsEvo.AtualizacaoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Atualização disponível"
        Width="420"
        SizeToContent="Height"
        MaxHeight="600"
        Background="{DynamicResource CorFundoPrincipal}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">

    <Window.Resources>
        <Style x:Key="BotaoFlat" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CorBotaoFlat}"/>
            <Setter Property="Foreground" Value="{DynamicResource CorTextoPrimario}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fundo" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fundo" Property="Background" Value="{DynamicResource CorBotaoFlatHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotaoPrimario" TargetType="Button" BasedOn="{StaticResource BotaoFlat}">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1387E8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="18">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="TxtTitulo"
                       Text="Atualização disponível"
                       Foreground="{DynamicResource CorTextoPrimario}"
                       FontSize="17"
                       FontWeight="Bold"/>
            <TextBlock x:Name="TxtVersaoNova"
                       Foreground="{DynamicResource CorTextoSecundario}"
                       FontSize="12"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <Border x:Name="ContainerAvisoBeta"
                Grid.Row="1"
                Background="#3D2F1E"
                BorderBrush="#B8860B"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10"
                Margin="0,0,0,10"
                Visibility="Collapsed">
            <TextBlock x:Name="TxtAvisoBeta"
                       Foreground="#E0B060"
                       FontSize="11"
                       TextWrapping="Wrap"/>
        </Border>

        <ScrollViewer Grid.Row="2" MaxHeight="280" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
            <StackPanel x:Name="PainelNotas"/>
        </ScrollViewer>

        <TextBlock x:Name="TxtAvisoFechamento"
                   Grid.Row="3"
                   Foreground="{DynamicResource CorTextoSecundario}"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="0,0,0,14"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnAgoraNao"
                    Content="Agora não"
                    Width="110"
                    Style="{StaticResource BotaoFlat}"
                    Margin="0,0,8,0"
                    Click="BtnAgoraNao_Click"/>
            <Button x:Name="BtnAtualizar"
                    Content="Atualizar agora"
                    Width="130"
                    Style="{StaticResource BotaoPrimario}"
                    Click="BtnAtualizar_Click"/>
        </StackPanel>

    </Grid>

</Window>